# MongoDB connection string. For local MongoDB use: mongodb://127.0.0.1:27017/voice_shopping
# For MongoDB Atlas, paste your connection string here.
MONGO_URI=mongodb://127.0.0.1:27017/voice_shopping

# Secret used to sign JWT tokens. Use any long random string in production.
JWT_SECRET=supersecret_change_this_in_production
JWT_EXPIRES_IN=7d

# Port the backend server runs on
PORT=5000

# URL of the frontend app (used for CORS)
CLIENT_URL=http://localhost:5173

# Optional payment gateway keys (sandbox/test mode). App runs fine with mock payments if left blank.
PAYMENT_KEY=
PAYMENT_SECRET=

# Optional: enables real Google OAuth ("Sign in with Google"). Get a free Client ID from
# https://console.cloud.google.com/apis/credentials (OAuth client ID > Web application).
# Leave blank to run without Google sign-in - the app works fully with email/password only.
GOOGLE_CLIENT_ID=166277873588-393203p8fs1v82b4jccakcqbhdpsmjda.apps.googleusercontent.com


# Seed script credentials for the default admin account (change before real use)
SEED_ADMIN_EMAIL=admin@voiceshop.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=demo@voiceshop.com
SEED_USER_PASSWORD=Demo@12345
